IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Bridge/Spotifast-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Bridge
LIBRARY_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)
OTHER_LDFLAGS = $(inherited) -lspotifast_ios_core -framework Security -framework SystemConfiguration -framework CoreFoundation -framework CFNetwork -framework Network -liconv -lresolv -lz
PRODUCT_BUNDLE_IDENTIFIER = local.spotifast.ios
PRODUCT_NAME = Spotifast
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/Config/Spotifast.entitlements
INFOPLIST_FILE = $(SRCROOT)/Config/Info.plist
GENERATE_INFOPLIST_FILE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_BITCODE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
SPOTIFY_CLIENT_ID =
// Optional personal bundle ID, signing team and public Spotify Client ID.
// Client secrets do not belong in a native PKCE application.
#include? "Local.xcconfig"
